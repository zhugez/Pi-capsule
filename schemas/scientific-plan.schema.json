{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen scientific experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "kind",
    "constraints",
    "scope",
    "protectedFiles",
    "correctness",
    "benchmark",
    "profile",
    "metric"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "optimization",
        "algorithm",
        "performance",
        "quality",
        "experiment"
      ]
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/).{1,2}(?:/|$))(?!.*(?:^|/).git(?:/|$))[^\\\u0000-\u001f]+$"
      }
    },
    "protectedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/).{1,2}(?:/|$))(?!.*(?:^|/).git(?:/|$))[^\\\u0000-\u001f]+$"
      }
    },
    "correctness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "benchmark": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "profile": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "lower",
            "higher"
          ]
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "config": {
      "$ref": "scientific-engineering.schema.json"
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
